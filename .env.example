# Copy to .env.local and fill in the values. Never commit .env.local.
# Names only here; values are secret or project-specific.

# Privy (email login + embedded accounts)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Supabase (server-only secret key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Solana devnet
HELIUS_DEVNET_RPC_URL=
TREASURY_SECRET_KEY=
CLUB_DOLLAR_MINT=

# Squads vault (from npm run setup-squads and npm run add-spending-limit)
SQUADS_MULTISIG_ADDRESS=
SQUADS_VAULT_ADDRESS=
SQUADS_SPENDING_LIMIT_ADDRESS=

# Anthropic (receipt reading)
ANTHROPIC_API_KEY=
